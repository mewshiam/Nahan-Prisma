# ── Nahan-Prisma runtime configuration ──────────────────────────────
# All values are optional. The server also runs with zero configuration:
#   bun run src/index.ts
# ─────────────────────────────────────────────────────────────────────

# TCP port the gateway listens on (Prisma Compute injects PORT automatically).
# Local default when unset: 3000
# PORT=3000

# Directory for the SQLite state file (replaces Cloudflare D1).
# Default: ./data
# DATA_DIR=./data

# Serve the dashboard/subscription pages from local files (default, recommended).
# Set to an https URL to override (e.g. your own hosted copy of the HTML).
# DASHBOARD_URL=
# SUBSCRIPTION_URL=

# Enable Prisma Compute request logging to stdout
# LOG_LEVEL=info
