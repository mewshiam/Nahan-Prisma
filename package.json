{
  "name": "nahan-prisma",
  "version": "1.1.0",
  "description": "Nahan — the serverless gateway, ported from Cloudflare Workers to Prisma Compute (Bun runtime)",
  "type": "module",
  "module": "module.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --hot src/index.ts",
    "build": "bun build src/compute.ts --outdir dist --target bun",
    "deploy": "bun run build && prisma deploy module.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@prisma/composer": "latest",
    "@prisma/composer-prisma-cloud": "latest",
    "@types/bun": "^1.4.3",
    "prisma": "latest",
    "typescript": "latest"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "nahan",
    "prisma",
    "prisma-compute",
    "bun",
    "vless",
    "trojan",
    "proxy",
    "gateway"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mewshiam/Nahan-Prisma"
  },
  "homepage": "https://github.com/mewshiam/Nahan-Prisma#readme",
  "bugs": {
    "url": "https://github.com/mewshiam/Nahan-Prisma/issues"
  },
  "dependencies": {
    "alchemy": "2.0.0-beta.78",
    "effect": "4.0.0-rc.115"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-mysql2": "4.0.0-rc.115",
    "@effect/sql-pg": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115",
    "effect": "4.0.0-rc.115"
  }
}
